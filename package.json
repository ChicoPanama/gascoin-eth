{
  "name": "gascoin-platform",
  "private": true,
  "version": "0.1.0",
  "scripts": {
    "dev": "next dev --webpack",
    "build": "next build --webpack",
    "start": "next start",
    "audit:prod": "npm audit --omit=dev",
    "audit:spec": "node scripts/post_audit.mjs",
    "phase0:preflight": "node scripts/phase0_preflight.mjs --mode=pretoken .env.local",
    "phase0:preflight:full": "node scripts/phase0_preflight.mjs --mode=full .env.local",
    "phase0:smoke": "node scripts/phase0_smoke.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:chromium": "playwright test --project=chromium",
    "test:e2e:gas": "playwright test e2e/01-homepage.spec.ts e2e/05-project-gas.spec.ts e2e/06-project-gas-phase9-read-models.spec.ts --project=chromium",
    "test:e2e:legacy": "playwright test e2e/02-navigation.spec.ts e2e/03-pages.spec.ts e2e/04-responsive.spec.ts --project=chromium",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:report": "playwright show-report",
    "test:all": "npm run test && npm run test:e2e:chromium",
    "sync:obsidian": "tsx scripts/sync-obsidian.ts",
    "seed:kb": "tsx scripts/seed-knowledge-base.ts"
  },
  "dependencies": {
    "@ai-sdk/gateway": "^3.0.95",
    "@ai-sdk/google": "^3.0.64",
    "@ai-sdk/openai": "^3.0.53",
    "@ai-sdk/react": "^3.0.169",
    "@privy-io/node": "^0.12.0",
    "@privy-io/react-auth": "3.37.1",
    "@privy-io/wagmi": "4.0.16",
    "@sentry/nextjs": "10.55.0",
    "@stripe/stripe-js": "9.13.0",
    "@supabase/supabase-js": "^2.49.8",
    "@tanstack/react-query": "^5.99.1",
    "@upstash/ratelimit": "^2.0.8",
    "@upstash/redis": "^1.37.0",
    "@vercel/edge-config": "^1.4.3",
    "@vercel/functions": "^3.4.4",
    "ai": "^6.0.158",
    "framer-motion": "^12.38.0",
    "next": "16.3.1",
    "p-limit": "^7.3.0",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "sharp": "0.35.3",
    "viem": "2.55.16",
    "wagmi": "3.7.6",
    "zod": "^4.3.6",
    "ws": "8.21.3"
  },
  "devDependencies": {
    "@faker-js/faker": "^10.4.0",
    "@playwright/test": "^1.59.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "25.5.0",
    "@types/react": "19.2.14",
    "@vitejs/plugin-react": "^6.0.1",
    "dotenv": "^17.4.0",
    "jsdom": "^29.0.1",
    "msw": "^2.12.14",
    "typescript": "5.9.3",
    "vitest": "^4.1.2"
  },
  "overrides": {
    "@coinbase/cdp-sdk": {
      "axios": "1.18.0"
    },
    "styled-components": "6.5.3",
    "@walletconnect/utils": "2.22.4",
    "@walletconnect/jsonrpc-ws-connection": {
      "ws": "7.5.13"
    }
  }
}
