# GASCOIN production environment template
NEXT_PUBLIC_BASE_URL=

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Privy
NEXT_PUBLIC_PRIVY_APP_ID=
PRIVY_APP_SECRET=
PRIVY_JWKS_URL=

# X
X_BEARER_TOKEN=
X_STRICT_MODE=true

# Solana / token
HELIUS_API_KEY=
SOLANA_RPC_URL=
GASCOIN_MINT=
GASCOIN_TREASURY_WALLET=

# Payout
ENABLE_LIVE_PAYOUT=false
TREASURY_PRIVATE_KEY_B58=

# Review auth
# SECURITY: REVIEWER_API_TOKEN is server-only. Never use NEXT_PUBLIC_ prefix for secrets.
REVIEWER_API_TOKEN=

# Distributed rate limit (recommended)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Cron job authentication (required for worker endpoints)
CRON_SECRET=
