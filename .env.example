# Core
NEXT_PUBLIC_BASE_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Privy
NEXT_PUBLIC_PRIVY_APP_ID=
PRIVY_APP_SECRET=
PRIVY_JWKS_URL=

# X API
X_BEARER_TOKEN=
X_STRICT_MODE=true

# Solana + Pricing
HELIUS_API_KEY=
GASCOIN_MINT=
GASCOIN_TREASURY_WALLET=
SOLANA_RPC_URL=
# Client-side copies (set to same values as above)
NEXT_PUBLIC_TREASURY_WALLET=
NEXT_PUBLIC_SOLANA_RPC_URL=
NEXT_PUBLIC_GASCOIN_MINT=

# ── AI Engine (Vercel AI Gateway — unified provider routing) ──
# On Vercel deployments, VERCEL_OIDC_TOKEN is auto-injected. For local dev run
# `vercel env pull .env.local` to provision it (~12h TTL). For CI or non-Vercel
# environments, set AI_GATEWAY_API_KEY directly.
AI_GATEWAY_API_KEY=
# Model overrides (provider/model format; dots for versions). Defaults live in lib/integrations/ai-gateway.ts.
GC_AI_MODEL_CLAUDE=anthropic/claude-sonnet-4.6
GC_AI_MODEL_GROK=xai/grok-4.1-fast-reasoning
GC_AI_MODEL_GEMINI_VISION=google/gemini-3-flash
GC_AI_MODEL_GEMINI_FAST=google/gemini-3-flash

# ── Legacy direct-provider keys (DEPRECATED — retained for fallback) ──
# Once AI_GATEWAY_API_KEY / OIDC is verified in prod, these can be removed.
OPENROUTER_API_KEY=
ANTHROPIC_API_KEY=
XAI_API_KEY=
MEM0_API_KEY=
MEM0_PROJECT_ID=gascoin-platform
OPENAI_API_KEY=

# Payout signer (server only)
TREASURY_PRIVATE_KEY_B58=
ENABLE_LIVE_PAYOUT=false
DEV_ALLOW_MOCK_AUTH=true
# SECURITY: REVIEWER_API_TOKEN is server-only. Never use NEXT_PUBLIC_ prefix for secrets.
REVIEWER_API_TOKEN=

# Optional distributed rate limit (recommended for multi-instance)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Cron job authentication (required for worker endpoints)
CRON_SECRET=
