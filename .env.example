# Core
NEXT_PUBLIC_BASE_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Privy
NEXT_PUBLIC_PRIVY_APP_ID=
PRIVY_APP_SECRET=
PRIVY_JWKS_URL=

# X API
X_BEARER_TOKEN=
X_STRICT_MODE=true

# Ethereum + Pricing
ALCHEMY_API_KEY=
ETH_RPC_URL=https://eth-mainnet.g.alchemy.com/v2/YOUR_ALCHEMY_KEY
NEXT_PUBLIC_ETH_RPC_URL=https://eth-mainnet.g.alchemy.com/v2/YOUR_ALCHEMY_KEY

# Project GAS D01 chain posture: Base mainnet is canonical; 84532 selects the
# Base Sepolia integration testnet. Other chain IDs fall back to Base mainnet.
NEXT_PUBLIC_PROJECT_GAS_CHAIN_ID=8453
NEXT_PUBLIC_BASE_RPC_URL=https://base-mainnet.g.alchemy.com/v2/YOUR_ALCHEMY_KEY
NEXT_PUBLIC_BASE_RPC_URL_FALLBACK_1=https://mainnet.base.org
NEXT_PUBLIC_BASE_SEPOLIA_RPC_URL=https://base-sepolia.g.alchemy.com/v2/YOUR_ALCHEMY_KEY
NEXT_PUBLIC_BASE_SEPOLIA_RPC_URL_FALLBACK_1=https://sepolia.base.org

# Remain unset until approved deployments are verified on the selected Base network.
# Native USDC is additionally validated against Circle's canonical deployment:
# Base 8453: 0x833589fCD6eDb6E08f4c7C32D4f71b54bdA02913
# Base Sepolia 84532: 0x036CbD53842c5426634e7929541eC2318f3dCF7e
# A missing or non-canonical value remains unavailable; it never falls back to a
# legacy or bridged token address.
NEXT_PUBLIC_PROJECT_GAS_TOKEN_ADDRESS=
NEXT_PUBLIC_PROJECT_GAS_USDC_ADDRESS=

# Base-native progressive enhancement. These flags describe approved runtime
# configuration only; they do not contain provider URLs, API keys or contracts.
NEXT_PUBLIC_PROJECT_GAS_PAYMASTER_ENABLED=false
NEXT_PUBLIC_PROJECT_GAS_BASE_PAY_ENABLED=false
NEXT_PUBLIC_PROJECT_GAS_ONRAMP_ENABLED=false
NEXT_PUBLIC_PROJECT_GAS_BUILDER_CODE_CONFIGURED=false

# Phase 9 authoritative actions. Keep live flags false until the configured
# source has passed Base Sepolia integration, idempotency and reconciliation tests.
NEXT_PUBLIC_PROJECT_GAS_GAME_LIVE_ENABLED=false
PROJECT_GAS_GAME_EXECUTION_URL=
PROJECT_GAS_GAME_EXECUTION_TOKEN=
PROJECT_GAS_TRADE_EXECUTION_URL=
PROJECT_GAS_TRADE_EXECUTION_TOKEN=
PROJECT_GAS_ACCOUNT_ACTION_URL=
PROJECT_GAS_ACCOUNT_ACTION_TOKEN=
PROJECT_GAS_TRADE_QUOTE_READ_URL=
PROJECT_GAS_TRADE_QUOTE_READ_TOKEN=
GASCOIN_CONTRACT_ADDRESS=0x
NEXT_PUBLIC_GASCOIN_CONTRACT_ADDRESS=0x
GASCOIN_TREASURY_WALLET=0x
NEXT_PUBLIC_TREASURY_WALLET=0x
GASCOIN_DECIMALS=18

# AI Engine (Vercel AI Gateway — unified provider routing)
AI_GATEWAY_API_KEY=
GC_AI_MODEL_CLAUDE=anthropic/claude-sonnet-4.6
GC_AI_MODEL_GROK=xai/grok-4.1-fast-reasoning
GC_AI_MODEL_GEMINI_VISION=google/gemini-3-flash
GC_AI_MODEL_GEMINI_FAST=google/gemini-3-flash

# Legacy direct-provider keys (DEPRECATED)
OPENROUTER_API_KEY=
ANTHROPIC_API_KEY=
XAI_API_KEY=
MEM0_API_KEY=
MEM0_PROJECT_ID=proj_
MEM0_ORG_ID=
MEM0_WEBHOOK_SECRET=
OPENAI_API_KEY=

# Payout signer (server only — hex private key 0x...)
TREASURY_PRIVATE_KEY=0x
ENABLE_LIVE_PAYOUT=false
# Alchemy webhook signing key — get from Alchemy dashboard → Webhooks → signing key
ALCHEMY_WEBHOOK_SIGNING_KEY=
DEV_ALLOW_MOCK_AUTH=true
REVIEWER_API_TOKEN=

# Optional distributed rate limit
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Cron job authentication
CRON_SECRET=

# AI Fraud thresholds
AI_SCORE_THRESHOLD=0.3
TAMPER_SCORE_THRESHOLD=0.3
FLAGS_THRESHOLD=2

# Gas Network Intelligence API — HMAC signing key (≥32 chars, rotate quarterly)
GASCOIN_API_SIGNING_KEY=

# Gas Network Piece 4 — reach certificate contract
# Deployed via contracts/gascoin-evm/script/DeployReachCertificate.s.sol
GASCOIN_CERTIFICATE_CONTRACT=0x

# Gas Network Piece 6 — Creator Marketplace
# Deploy contract via contracts/gascoin-evm/script/DeployMarketplace.s.sol
GASCOIN_USDC_ADDRESS=0xA0b86991c6218b36c1d19D4a2e9Eb0cE3606eB48
GASCOIN_OPS_WALLET=0x
GASCOIN_MARKETPLACE_VERIFIER=0x
GASCOIN_MARKETPLACE_VERIFIER_KEY=0x
GASCOIN_MARKETPLACE_CONTRACT=0x
# Feature flag: flip to 'true' when public UIs are ready
GAS_NETWORK_MARKETPLACE_LIVE=false
