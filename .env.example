# Core
NEXT_PUBLIC_BASE_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Privy
NEXT_PUBLIC_PRIVY_APP_ID=
PRIVY_APP_SECRET=
PRIVY_JWKS_URL=

# X API
X_BEARER_TOKEN=
X_STRICT_MODE=true

# Solana + Pricing
HELIUS_API_KEY=
GASCOIN_MINT=
GASCOIN_TREASURY_WALLET=
SOLANA_RPC_URL=
# Client-side copies (set to same values as above)
NEXT_PUBLIC_TREASURY_WALLET=
NEXT_PUBLIC_SOLANA_RPC=
NEXT_PUBLIC_GASCOIN_MINT=

# Receipt Processing (OpenRouter — uses Gemini Flash)
OPENROUTER_API_KEY=
RECEIPT_OCR_MODEL=google/gemini-2.0-flash-lite
RECEIPT_FRAUD_MODEL=google/gemini-2.0-flash
# Legacy (optional — only if not using OpenRouter)
OPENAI_API_KEY=

# Payout signer (server only)
TREASURY_PRIVATE_KEY_B58=
ENABLE_LIVE_PAYOUT=false
DEV_ALLOW_MOCK_AUTH=true
# SECURITY: REVIEWER_API_TOKEN is server-only. Never use NEXT_PUBLIC_ prefix for secrets.
REVIEWER_API_TOKEN=

# Optional distributed rate limit (recommended for multi-instance)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Cron job authentication (required for worker endpoints)
CRON_SECRET=
